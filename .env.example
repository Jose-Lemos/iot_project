# Copiá este archivo a .env. En una instalación nueva, elegí una contraseña
# aleatoria para DB_PASSWORD. Un volumen PostgreSQL existente conserva su
# contraseña previa; cambiar esta variable no modifica el volumen.
# Para entrar desde otro dispositivo, agregá su IP a DJANGO_ALLOWED_HOSTS y
# el origen del frontend a CORS_ALLOWED_ORIGINS.
# Para producción: DJANGO_DEBUG=false, DJANGO_SECRET_KEY aleatoria y HTTPS.
DB_USER=iot_user
DB_PASSWORD=replace-with-a-long-random-password
DB_NAME=iot_data
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
CREATE_DEMO_USER=true
DJANGO_SECURE_SSL_REDIRECT=false

# Opcional: asistente de IA y notificaciones.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
